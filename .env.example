# OpenVibe.Rent — environment (production: /etc/openvibe/rent.env). Names only; never commit values.

NODE_ENV=production
PORT=5010
HOST=127.0.0.1
BASE_URL=https://openvibe.rent
TRUST_PROXY=2
# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh rent: the runtime role through PgBouncer,
# the owner on a direct connection (migrations), and Valkey (shared limit counters).
# Without DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:rent:
# Per-caller limits (server/http/caller-limits.js): requests one caller may make to the API per minute and per hour.
#RENT_LIMITS_MINUTE=120
#RENT_LIMITS_HOUR=3000

# OpenVibe.Network: SSO (OAuth client `rent`, PKCE S256) and its JWKS; app tokens for audience openvibe.rent.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=rent
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.rent/auth/callback
# RENT_AUDIENCE=openvibe.rent

# optional: defaults to true in production
# COOKIE_SECURE=true
